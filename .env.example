# Local development only. Never commit a populated .env file.
PORT=3000
NODE_ENV=development
# Give only DATABASE_APP_URL to Web and only DATABASE_WORKER_URL to Worker.
# Production uses direct/Supavisor Session mode (5432), never transaction mode
# (6543). Shared Supavisor usernames are role.project_ref.
DATABASE_APP_URL=postgresql://app_backend:password@127.0.0.1:54322/postgres?schema=public&sslmode=require&connection_limit=5&pool_timeout=10&application_name=aiseo-web
DATABASE_WORKER_URL=postgresql://app_worker:password@127.0.0.1:54322/postgres?schema=public&sslmode=require&connection_limit=5&pool_timeout=10&application_name=aiseo-worker
# Owner-only URL for migrations and the audited administrator bootstrap command.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public
REDIS_URL=redis://127.0.0.1:6379
# Generate once with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1
# JSON map retained during key rotation, e.g. {"1":"old-base64","2":"new-base64"}
APP_ENCRYPTION_KEYS=
# Optional on Railway when RAILWAY_PUBLIC_DOMAIN is available; set explicitly for custom domains.
APP_BASE_URL=http://localhost:3000
# Set this to the exact number of trusted reverse-proxy hops when deployed
# outside Railway. It enables correct client-IP rate limiting.
TRUST_PROXY_HOPS=
TZ=Asia/Shanghai

# Supabase Auth. Only Web receives the publishable key. Neither Web nor Worker
# receives the service-role key; delayed account erasure uses the isolated
# Supabase Edge Function deployment boundary.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Edge Functions only. Never set this on the Railway Web or Worker service.
SUPABASE_SERVICE_ROLE_KEY=
# Optional for Vite-only local development. Production reads the two values
# above at container startup through /runtime-config.js.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Turnstile secret and SMTP credentials configure local Supabase only. In hosted
# production configure them in the Supabase Dashboard, never in Web/Worker.
# VITE_TURNSTILE_SITE_KEY is public and belongs only in the Web runtime.
# Custom SMTP used by local Supabase Auth
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# AI generation (server only)
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Search Console OAuth (server only)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_STATE_SECRET=

# DataForSEO platform account (server only)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# TRC20 USDT verification (server only; no private key is required or supported)
TRONGRID_API_KEY=
TRC20_RECIPIENT_ADDRESS=
TRC20_USDT_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
PAYMENT_INTENT_MINUTES=30

# Observability
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_RELEASE=
