# Local development only. Never commit a populated .env file.
PORT=3000
NODE_ENV=development
# Web and Worker must use distinct LOGIN roles granted app_backend/app_worker.
DATABASE_APP_URL=postgresql://app_backend:password@127.0.0.1:54322/postgres?schema=public
DATABASE_WORKER_URL=postgresql://app_worker:password@127.0.0.1:54322/postgres?schema=public
# Owner-only URL for migrations and the audited administrator bootstrap command.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public
REDIS_URL=redis://127.0.0.1:6379
# Generate once with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1
# JSON map retained during key rotation, e.g. {"1":"old-base64","2":"new-base64"}
APP_ENCRYPTION_KEYS=
# Optional on Railway when RAILWAY_PUBLIC_DOMAIN is available; set explicitly for custom domains.
APP_BASE_URL=http://localhost:3000
# Set this to the exact number of trusted reverse-proxy hops when deployed
# outside Railway. It enables correct client-IP rate limiting.
TRUST_PROXY_HOPS=
TZ=Asia/Shanghai

# Supabase Auth (publishable key is safe for the browser; service role is server-only)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Custom SMTP used by Supabase Auth
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# AI generation (server only)
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Search Console OAuth (server only)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_STATE_SECRET=

# DataForSEO platform account (server only)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# TRC20 USDT verification (server only; no private key is required or supported)
TRONGRID_API_KEY=
TRC20_RECIPIENT_ADDRESS=
TRC20_USDT_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
PAYMENT_INTENT_MINUTES=30

# Observability
SENTRY_DSN=
VITE_SENTRY_DSN=
