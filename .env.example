# Local development only. Never commit a populated .env file.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public
REDIS_URL=redis://127.0.0.1:6379
# Generate once with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Optional on Railway when RAILWAY_PUBLIC_DOMAIN is available; set explicitly for custom domains.
APP_BASE_URL=http://localhost:3000
# Set this to the exact number of trusted reverse-proxy hops when deployed
# outside Railway. It enables correct client-IP rate limiting.
TRUST_PROXY_HOPS=
TZ=Asia/Shanghai

# Only enable local fixtures explicitly; production rejects all synthetic content.
DEMO_MODE=false
ALLOW_SYNTHETIC_CONTENT=false

# AI generation (server only)
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
PREFERRED_AI_PROVIDER=auto

# Google Search Console OAuth (server only)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_STATE_SECRET=

# DataForSEO platform account (server only)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_SERP_CREDIT_COST=5

# TRC20 USDT verification (server only; no private key is required or supported)
TRONGRID_API_KEY=
TRC20_RECIPIENT_ADDRESS=
TRC20_USDT_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
PAYMENT_INTENT_MINUTES=30
SESSION_HOURS=24

# Legacy development bootstrap only; production uses /api/v1 registration.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
