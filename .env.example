# Gemini API Key & Model for server-side generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# OpenAI API Key & Model (Optionally use GPT-4o for high-quality generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Preferred AI Provider: 'auto', 'openai', or 'gemini'
PREFERRED_AI_PROVIDER=auto

# Tier 1 & 2 Free SERP API Keys (Serper.dev Free 2500 Quota / Google CSE 100/day)
SERPER_FREE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Tier 3 Paid SERP API Key (Triggered automatically when Free Tier daily/monthly limits are exceeded)
SERPER_PAID_API_KEY=
