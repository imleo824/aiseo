generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum SiteConnectionStatus {
  NOT_CONFIGURED
  VERIFYING
  CONNECTED
  FAILED
}

enum WordPressCompatibilityMode {
  RECHECK_REQUIRED
  FULL_AUTO
  SAFE_AUTO
  ANALYSIS_ONLY
  BLOCKED
}

enum WordPressEditorKind {
  CLASSIC
  GUTENBERG
  ELEMENTOR
  DIVI
  HEADLESS
  UNKNOWN
}

enum WordPressRemoteMutationState {
  PREPARED
  COMMITTED
  VERIFIED
  VISIBILITY_PENDING
  CONFLICTED
  FAILED
  ROLLED_BACK
}

enum IntegrationProvider {
  GSC
}

enum JobType {
  GROWTH_RUN
  GSC_SYNC
  GROWTH_MEASURE
  WORDPRESS_PUBLISH
  WORDPRESS_ROLLBACK
  PAYMENT_VERIFY
  AUTOMATION_RECONCILE
  INDEXING_MONITOR
}

enum GrowthProgramMode {
  ONCE
  CONTINUOUS
}

enum GrowthInputType {
  KEYWORD
  REFERENCE_URL
  COMPETITOR_SITE
}

enum GrowthProgramStatus {
  ACTIVE
  PAUSED
  COMPLETED
  BLOCKED
}

enum GrowthRunStatus {
  QUEUED
  RUNNING
  NEEDS_REVIEW
  DELIVERED
  SKIPPED
  BLOCKED
  FAILED
  CANCELLED
}

enum GrowthRunStageCode {
  UNDERSTAND
  DISCOVER
  DECIDE
  EXECUTE
  LEARN
}

enum GrowthRunStageStatus {
  PENDING
  RUNNING
  COMPLETED
  SKIPPED
  BLOCKED
  FAILED
}

enum GrowthRunTrigger {
  USER
  SCHEDULED
  DATA_CHANGE
  OBSERVATION
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum DataSource {
  GSC
  DATAFORSEO
  KNOWLEDGE
}

enum DataStatus {
  LIVE
  PENDING
  UNAVAILABLE
  STALE
}

enum KnowledgeSourceRole {
  TARGET_SITE
  REFERENCE
  COMPETITOR
}

enum OpportunityType {
  CONTENT_GAP
  EXISTING_PAGE
  RANK_11_20
  HIGH_IMPRESSION_LOW_CTR
  CONTENT_DECAY
  INDEX_GAP
  TOPIC_GAP
  TECHNICAL_BLOCK
  INTERNAL_LINK_GAP
  CANNIBALIZATION
  COMPETITOR_GAP
  AI_CITATION_GAP
  AI_MENTION_GAP
  NEW_DEMAND
}

enum OpportunityStatus {
  OPEN
  SELECTED
  DISMISSED
  CONVERTED
}

enum PaymentStatus {
  AWAITING_TRANSFER
  VERIFYING
  CONFIRMED
  CREDITED
  REJECTED
  EXPIRED
}

enum LedgerEntryType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  REVERSAL
}

enum CreditHoldStatus {
  HELD
  SETTLED
  RELEASED
}

enum DraftStatus {
  GENERATING
  QUALITY_FAILED
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  ROLLED_BACK
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

enum PublishAttemptStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum GrowthDecisionStatus {
  PROPOSED
  SELECTED
  DEFERRED
  REJECTED
  EXECUTED
}

enum GrowthActionType {
  UPDATE_TITLE
  ADD_INTERNAL_LINKS
  CONTENT_REFRESH
  ADD_CONTENT_SECTION
  CREATE_CONTENT
  DIAGNOSE_ONLY
}

enum GrowthActionStatus {
  PLANNED
  REVIEW_REQUIRED
  APPROVED
  EXECUTING
  VERIFYING
  OBSERVING
  SUCCEEDED
  FAILED
  ROLLED_BACK
  CANCELLED
}

enum GrowthRiskLevel {
  A
  B
  C
  D
}

enum GrowthAutonomyDecision {
  AUTO_EXECUTE
  REQUIRE_REVIEW
  REJECT
}

enum PageVersionKind {
  BEFORE
  AFTER
  ROLLBACK
}

enum MeasurementSource {
  GSC
  LEADING_INDICATORS
  DATAFORSEO_RANK
}

enum GrowthOutcome {
  NOT_READY
  WIN
  NEUTRAL
  LOSS
  INCONCLUSIVE
}

model Profile {
  id                  String               @id @db.Uuid
  email               String               @unique
  displayName         String?              @map("display_name")
  platformRole        PlatformRole         @default(USER) @map("platform_role")
  suspendedAt         DateTime?            @map("suspended_at")
  deletionRequestedAt DateTime?            @map("deletion_requested_at")
  erasureClaimedAt    DateTime?            @map("erasure_claimed_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  memberships         OrganizationMember[]
  reviews             DraftReview[]
  auditEvents         AuditEvent[]         @relation("AuditActor")
  idempotencyKeys     IdempotencyKey[]
  termsAcceptances    TermsAcceptance[]
  notifications       Notification[]

  @@map("profiles")
}

model Organization {
  id                             String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                           String
  creditBalanceMicros            BigInt                          @default(0) @map("credit_balance_micros")
  disabledAt                     DateTime?                       @map("disabled_at")
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  members                        OrganizationMember[]
  sites                          Site[]
  integrations                   IntegrationConnection[]
  knowledgeContentBlobs          KnowledgeContentBlob[]
  knowledgeSources               KnowledgeSource[]
  dataSnapshots                  DataSnapshot[]
  keywordScans                   KeywordScan[]
  opportunities                  Opportunity[]
  growthPrograms                 GrowthProgram[]
  growthProgramInputs            GrowthProgramInput[]
  growthRuns                     GrowthRun[]
  growthRunStages                GrowthRunStage[]
  jobs                           JobRun[]
  drafts                         ContentDraft[]
  publishAttempts                PublishAttempt[]
  payments                       PaymentIntent[]
  ledgerEntries                  LedgerEntry[]
  creditHolds                    CreditHold[]
  usageRecords                   UsageRecord[]
  auditEvents                    AuditEvent[]
  idempotencyKeys                IdempotencyKey[]
  termsAcceptances               TermsAcceptance[]
  notifications                  Notification[]
  indexingObservations           IndexingObservation[]
  growthDecisions                GrowthDecision[]
  growthActions                  GrowthAction[]
  siteSnapshots                  SiteSnapshot[]
  sitePageSnapshots              SitePageSnapshot[]
  actionEvidence                 ActionEvidence[]
  pageVersions                   PageVersion[]
  measurementSamples             MeasurementSample[]
  siteMutationLeases             SiteMutationLease[]
  wordpressCompatibilityProfiles WordPressCompatibilityProfile[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String           @map("organization_id") @db.Uuid
  profileId      String           @map("profile_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([organizationId, profileId])
  @@index([profileId, organizationId])
  @@map("organization_members")
}

model Site {
  id                                    String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                        String                          @map("organization_id") @db.Uuid
  domain                                String
  name                                  String
  language                              String                          @default("zh-CN")
  wordpressCredentials                  Bytes?                          @map("wordpress_credentials")
  wordpressCredentialKeyVersion         Int?                            @map("wordpress_credential_key_version")
  wordpressStatus                       SiteConnectionStatus            @default(NOT_CONFIGURED) @map("wordpress_status")
  wordpressUser                         String?                         @map("wordpress_user")
  wordpressVerifiedAt                   DateTime?                       @map("wordpress_verified_at")
  wordpressCompatibilityMode            WordPressCompatibilityMode      @default(RECHECK_REQUIRED) @map("wordpress_compatibility_mode")
  wordpressCompatibilityCheckedAt       DateTime?                       @map("wordpress_compatibility_checked_at") @db.Timestamptz(6)
  latestWordpressCompatibilityProfileId String?                         @unique(map: "sites_latest_wordpress_compatibility_profile_key") @map("latest_wordpress_compatibility_profile_id") @db.Uuid
  createdAt                             DateTime                        @default(now()) @map("created_at")
  updatedAt                             DateTime                        @updatedAt @map("updated_at")
  organization                          Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrations                          IntegrationConnection[]
  knowledgeSources                      KnowledgeSource[]
  dataSnapshots                         DataSnapshot[]
  keywordScans                          KeywordScan[]
  opportunities                         Opportunity[]
  growthPrograms                        GrowthProgram[]
  growthProgramInputs                   GrowthProgramInput[]
  growthRuns                            GrowthRun[]
  growthRunStages                       GrowthRunStage[]
  drafts                                ContentDraft[]
  indexingObservations                  IndexingObservation[]
  growthDecisions                       GrowthDecision[]
  growthActions                         GrowthAction[]
  siteSnapshots                         SiteSnapshot[]
  sitePageSnapshots                     SitePageSnapshot[]
  actionEvidence                        ActionEvidence[]
  pageVersions                          PageVersion[]
  measurementSamples                    MeasurementSample[]
  mutationLease                         SiteMutationLease?
  wordpressCompatibilityProfiles        WordPressCompatibilityProfile[] @relation("SiteWordPressCompatibilityProfiles")
  latestWordpressCompatibilityProfile   WordPressCompatibilityProfile?  @relation("LatestWordPressCompatibilityProfile", fields: [latestWordpressCompatibilityProfileId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "sites_latest_wordpress_compatibility_profile_fkey")

  @@unique([organizationId, domain])
  @@index([organizationId, createdAt])
  @@map("sites")
}

model IntegrationConnection {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  siteId               String               @map("site_id") @db.Uuid
  provider             IntegrationProvider
  encryptedCredentials Bytes                @map("encrypted_credentials")
  keyVersion           Int                  @map("key_version")
  propertyId           String?              @map("property_id")
  status               SiteConnectionStatus @default(VERIFYING)
  lastSyncedAt         DateTime?            @map("last_synced_at")
  lastErrorCode        String?              @map("last_error_code")
  lastErrorMessage     String?              @map("last_error_message")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  site                 Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([siteId, provider])
  @@index([organizationId, provider, status])
  @@map("integration_connections")
}

model KnowledgeContentBlob {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  checksum       String
  content        String
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sources        KnowledgeSource[]

  @@unique([organizationId, checksum], map: "knowledge_content_blobs_org_checksum_key")
  @@index([organizationId, createdAt(sort: Desc)], map: "knowledge_content_blobs_org_created_idx")
  @@map("knowledge_content_blobs")
}

model KnowledgeSource {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  siteId              String               @map("site_id") @db.Uuid
  contentBlobId       String               @map("content_blob_id") @db.Uuid
  role                KnowledgeSourceRole
  identityFingerprint String               @map("identity_fingerprint")
  title               String
  sourceUrl           String               @map("source_url")
  normalizedUrl       String               @map("normalized_url")
  summary             String?
  status              DataStatus           @default(LIVE)
  fetchedAt           DateTime?            @map("fetched_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  site                Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contentBlob         KnowledgeContentBlob @relation(fields: [contentBlobId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, identityFingerprint], map: "knowledge_sources_org_identity_key")
  @@index([organizationId, siteId, role, status, createdAt(sort: Desc)], map: "knowledge_sources_org_site_role_status_idx")
  @@index([siteId])
  @@index([contentBlobId])
  @@map("knowledge_sources")
}

model DataSnapshot {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  siteId               String?             @map("site_id") @db.Uuid
  source               DataSource
  status               DataStatus
  formulaVersion       String?             @map("formula_version")
  providerTaskId       String?             @map("provider_task_id")
  fetchedAt            DateTime            @default(now()) @map("fetched_at")
  availableFrom        DateTime?           @map("available_from")
  periodStart          DateTime?           @map("period_start") @db.Date
  periodEnd            DateTime?           @map("period_end") @db.Date
  comparisonSnapshotId String?             @map("comparison_snapshot_id") @db.Uuid
  payload              Json
  createdAt            DateTime            @default(now()) @map("created_at")
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                 Site?               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keywordScans         KeywordScan[]
  opportunities        Opportunity[]
  drafts               ContentDraft[]      @relation("DraftSeoSnapshot")
  comparisonSnapshot   DataSnapshot?       @relation("SnapshotComparison", fields: [comparisonSnapshotId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  comparisonFor        DataSnapshot[]      @relation("SnapshotComparison")
  measurementSamples   MeasurementSample[]

  @@index([organizationId, source, fetchedAt])
  @@index([siteId, source, fetchedAt])
  @@index([siteId, source, periodEnd(sort: Desc)], map: "data_snapshots_site_source_period_end_idx")
  @@index([comparisonSnapshotId])
  @@index([providerTaskId])
  @@map("data_snapshots")
}

model KeywordScan {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  siteId         String        @map("site_id") @db.Uuid
  snapshotId     String?       @map("snapshot_id") @db.Uuid
  seedKeyword    String        @map("seed_keyword")
  languageCode   String        @map("language_code")
  locationCode   Int           @map("location_code")
  status         JobStatus     @default(QUEUED)
  resultCount    Int           @default(0) @map("result_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  completedAt    DateTime?     @map("completed_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  snapshot       DataSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  opportunities  Opportunity[]

  @@index([organizationId, siteId, createdAt])
  @@index([siteId])
  @@index([snapshotId])
  @@map("keyword_scans")
}

model Opportunity {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String            @map("organization_id") @db.Uuid
  siteId                   String            @map("site_id") @db.Uuid
  keywordScanId            String?           @map("keyword_scan_id") @db.Uuid
  snapshotId               String            @map("snapshot_id") @db.Uuid
  siteSnapshotId           String?           @map("site_snapshot_id") @db.Uuid
  type                     OpportunityType
  status                   OpportunityStatus @default(OPEN)
  sourceKey                String?           @map("source_key")
  title                    String
  targetUrl                String?           @map("target_url")
  keyword                  String?
  searchVolume             Int?              @map("search_volume")
  keywordDifficulty        Int?              @map("keyword_difficulty")
  roiScoreMicros           BigInt?           @map("roi_score_micros")
  evidence                 Json              @default("{}")
  trafficPotentialMicros   BigInt?           @map("traffic_potential_micros")
  businessRelevanceMicros  BigInt?           @map("business_relevance_micros")
  successProbabilityMicros BigInt?           @map("success_probability_micros")
  confidenceMicros         BigInt?           @map("confidence_micros")
  executionCostMicros      BigInt?           @map("execution_cost_micros")
  riskPenaltyMicros        BigInt?           @map("risk_penalty_micros")
  expectedValueMicros      BigInt?           @map("expected_value_micros")
  timeToImpactDays         Int?              @map("time_to_impact_days")
  formulaVersion           String            @map("formula_version")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                     Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keywordScan              KeywordScan?      @relation(fields: [keywordScanId], references: [id], onDelete: SetNull)
  snapshot                 DataSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  siteSnapshot             SiteSnapshot?     @relation("OpportunitySiteSnapshot", fields: [siteSnapshotId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  drafts                   ContentDraft[]
  decisions                GrowthDecision[]
  actions                  GrowthAction[]
  growthRuns               GrowthRun[]

  @@unique([siteId, sourceKey])
  @@index([organizationId, siteId, status, createdAt])
  @@index([siteId, status, expectedValueMicros(sort: Desc)], map: "opportunities_site_status_expected_value_idx")
  @@index([keywordScanId])
  @@index([snapshotId])
  @@index([siteSnapshotId], map: "opportunities_site_snapshot_idx")
  @@map("opportunities")
}

model GrowthProgram {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String               @map("organization_id") @db.Uuid
  siteId                  String               @map("site_id") @db.Uuid
  mode                    GrowthProgramMode
  inputFingerprint        String               @map("input_fingerprint")
  status                  GrowthProgramStatus  @default(ACTIVE)
  budgetLimitMicros       BigInt?              @map("budget_limit_micros")
  nextRunAt               DateTime?            @map("next_run_at") @db.Timestamptz(6)
  lastRunAt               DateTime?            @map("last_run_at") @db.Timestamptz(6)
  lockedUntil             DateTime?            @map("locked_until") @db.Timestamptz(6)
  consecutiveWins         Int                  @default(0) @map("consecutive_wins")
  deliveredRunCount       Int                  @default(0) @map("delivered_run_count")
  lastEvidenceFingerprint String?              @map("last_evidence_fingerprint")
  lastEvidenceAt          DateTime?            @map("last_evidence_at") @db.Timestamptz(6)
  lastError               String?              @map("last_error")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  site                    Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inputs                  GrowthProgramInput[]
  runs                    GrowthRun[]

  @@unique([organizationId, inputFingerprint], map: "growth_programs_org_fingerprint_key")
  @@index([organizationId, siteId, createdAt(sort: Desc)], map: "growth_programs_org_site_created_idx")
  @@index([siteId], map: "growth_programs_site_id_idx")
  @@map("growth_programs")
}

model GrowthProgramInput {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  siteId           String          @map("site_id") @db.Uuid
  programId        String          @map("program_id") @db.Uuid
  type             GrowthInputType
  value            String
  normalizedValue  String          @map("normalized_value")
  valueFingerprint String          @map("value_fingerprint")
  position         Int
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  site             Site            @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  program          GrowthProgram   @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([programId, valueFingerprint], map: "growth_program_inputs_program_fingerprint_key")
  @@unique([programId, position], map: "growth_program_inputs_program_position_key")
  @@index([organizationId, programId, position], map: "growth_program_inputs_org_program_position_idx")
  @@index([siteId, type], map: "growth_program_inputs_site_type_idx")
  @@map("growth_program_inputs")
}

model GrowthRun {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  siteId             String             @map("site_id") @db.Uuid
  programId          String             @map("program_id") @db.Uuid
  jobRunId           String?            @unique @map("job_run_id") @db.Uuid
  opportunityId      String?            @map("opportunity_id") @db.Uuid
  draftId            String?            @map("draft_id") @db.Uuid
  trigger            GrowthRunTrigger
  status             GrowthRunStatus    @default(QUEUED)
  currentStage       GrowthRunStageCode @default(UNDERSTAND) @map("current_stage")
  occurrenceKey      String             @map("occurrence_key")
  resolvedKeyword    String?            @map("resolved_keyword")
  selectedActionType GrowthActionType?  @map("selected_action_type")
  targetUrl          String?            @map("target_url")
  knowledgeSourceIds String[]           @default([]) @map("knowledge_source_ids") @db.Uuid
  delivery           Json?
  observation        Json?
  errorCode          String?            @map("error_code")
  errorMessage       String?            @map("error_message")
  startedAt          DateTime?          @map("started_at") @db.Timestamptz(6)
  deliveredAt        DateTime?          @map("delivered_at") @db.Timestamptz(6)
  finishedAt         DateTime?          @map("finished_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  site               Site               @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  program            GrowthProgram      @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobRun             JobRun?            @relation(fields: [jobRunId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  opportunity        Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  draft              ContentDraft?      @relation(fields: [draftId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stages             GrowthRunStage[]
  decisions          GrowthDecision[]
  actions            GrowthAction[]
  siteSnapshot       SiteSnapshot?
  mutationLease      SiteMutationLease?

  @@unique([programId, occurrenceKey], map: "growth_runs_program_occurrence_key")
  @@index([organizationId, siteId, createdAt(sort: Desc)], map: "growth_runs_org_site_created_idx")
  @@index([programId, status, createdAt(sort: Desc)], map: "growth_runs_program_status_created_idx")
  @@index([siteId, status, updatedAt], map: "growth_runs_site_status_updated_idx")
  @@index([opportunityId], map: "growth_runs_opportunity_idx")
  @@index([draftId], map: "growth_runs_draft_idx")
  @@map("growth_runs")
}

model GrowthRunStage {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  siteId         String               @map("site_id") @db.Uuid
  runId          String               @map("run_id") @db.Uuid
  stage          GrowthRunStageCode
  status         GrowthRunStageStatus @default(PENDING)
  summary        String?
  processedCount Int                  @default(0) @map("processed_count")
  totalCount     Int?                 @map("total_count")
  evidence       Json                 @default("[]")
  errorCode      String?              @map("error_code")
  errorMessage   String?              @map("error_message")
  startedAt      DateTime?            @map("started_at") @db.Timestamptz(6)
