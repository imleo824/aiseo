  @@map("ledger_entries")
}

model CreditHold {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  jobRunId       String           @unique @map("job_run_id") @db.Uuid
  amountMicros   BigInt           @map("amount_micros")
  status         CreditHoldStatus @default(HELD)
  reason         String
  createdAt      DateTime         @default(now()) @map("created_at")
  settledAt      DateTime?        @map("settled_at")
  releasedAt     DateTime?        @map("released_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobRun         JobRun           @relation(fields: [jobRunId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("credit_holds")
}

model UsageRecord {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  jobRunId       String?      @map("job_run_id") @db.Uuid
  action         String
  amountMicros   BigInt       @map("amount_micros")
  resultType     String?      @map("result_type")
  resultId       String?      @map("result_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobRun         JobRun?      @relation(fields: [jobRunId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organizationId, createdAt])
  @@index([jobRunId])
  @@map("usage_records")
}

model IdempotencyKey {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  profileId      String        @map("profile_id") @db.Uuid
  key            String        @db.Uuid
  requestHash    String        @map("request_hash")
  response       Json?
  statusCode     Int?          @map("status_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  expiresAt      DateTime      @map("expires_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, organizationId, key])
  @@index([expiresAt])
  @@index([organizationId])
  @@map("idempotency_keys")
}

model AuditEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  action         String
  targetType     String        @map("target_type")
  targetId       String?       @map("target_id")
  traceId        String?       @map("trace_id")
  ipHash         String?       @map("ip_hash")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          Profile?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

model TermsAcceptance {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  profileId      String        @map("profile_id") @db.Uuid
  document       String
  version        String
  acceptedAt     DateTime      @default(now()) @map("accepted_at")
  ipHash         String?       @map("ip_hash")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profileId, organizationId, document, version])
  @@index([organizationId])
  @@map("terms_acceptances")
}

model Notification {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  profileId      String?            @map("profile_id") @db.Uuid
  type           String
  title          String
  message        String
  status         NotificationStatus @default(UNREAD)
  metadata       Json?
  createdAt      DateTime           @default(now()) @map("created_at")
  readAt         DateTime?          @map("read_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile?           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([organizationId, profileId, status, createdAt])
  @@index([profileId])
  @@map("notifications")
}

model WorkerHeartbeat {
  workerId       String   @id @map("worker_id")
  queues         String[]
  processVersion String   @map("process_version")
  capabilities   Json     @default("{}")
  heartbeatAt    DateTime @map("heartbeat_at")
  startedAt      DateTime @map("started_at")

  @@index([heartbeatAt])
  @@map("worker_heartbeats")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
