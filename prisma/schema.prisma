generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum SiteConnectionStatus {
  NOT_CONFIGURED
  VERIFYING
  CONNECTED
  FAILED
}

enum PublishPolicy {
  MANUAL_REVIEW
  AUTO_PUBLISH
  PAUSED
}

enum IntegrationProvider {
  GSC
}

enum JobType {
  GROWTH_RUN
  AUTONOMOUS_EXECUTION
  GSC_SYNC
  DATAFORSEO_KEYWORD_SCAN
  CONTENT_GENERATION
  GROWTH_CYCLE
  GROWTH_ACTION_EXECUTE
  GROWTH_MEASURE
  WORDPRESS_PUBLISH
  WORDPRESS_ROLLBACK
  PAYMENT_VERIFY
  AUTOMATION_RECONCILE
  INDEXING_MONITOR
}

enum GrowthProgramMode {
  ONCE
  CONTINUOUS
}

enum GrowthInputType {
  KEYWORD
  REFERENCE_URL
  COMPETITOR_SITE
}

enum GrowthProgramStatus {
  ACTIVE
  PAUSED
  COMPLETED
  BLOCKED
}

enum GrowthRunStatus {
  QUEUED
  RUNNING
  NEEDS_REVIEW
  DELIVERED
  BLOCKED
  FAILED
  CANCELLED
}

enum GrowthRunStageCode {
  UNDERSTAND
  DISCOVER
  DECIDE
  EXECUTE
  LEARN
}

enum GrowthRunStageStatus {
  PENDING
  RUNNING
  COMPLETED
  SKIPPED
  BLOCKED
  FAILED
}

enum GrowthRunTrigger {
  USER
  SCHEDULED
  DATA_CHANGE
  OBSERVATION
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum DataSource {
  GSC
  DATAFORSEO
  KNOWLEDGE
}

enum DataStatus {
  LIVE
  PENDING
  UNAVAILABLE
  STALE
}

enum KnowledgeSourceType {
  TEXT
  ORIGINAL_RESEARCH
  ALLOWLISTED_URL
}

enum OpportunityType {
  KGR
  CONTENT_GAP
  EXISTING_PAGE
  RANK_11_20
  HIGH_IMPRESSION_LOW_CTR
  CONTENT_DECAY
  INDEX_GAP
  TOPIC_GAP
  TECHNICAL_BLOCK
  INTERNAL_LINK_GAP
  CANNIBALIZATION
  COMPETITOR_GAP
  AI_CITATION_GAP
  AI_MENTION_GAP
  NEW_DEMAND
}

enum OpportunityStatus {
  OPEN
  SELECTED
  DISMISSED
  CONVERTED
}

enum PaymentStatus {
  AWAITING_TRANSFER
  VERIFYING
  CONFIRMED
  CREDITED
  REJECTED
  EXPIRED
}

enum LedgerEntryType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  REVERSAL
}

enum CreditHoldStatus {
  HELD
  SETTLED
  RELEASED
}

enum DraftStatus {
  GENERATING
  QUALITY_FAILED
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  ROLLED_BACK
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

enum PublishAttemptStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum GrowthDecisionStatus {
  PROPOSED
  SELECTED
  DEFERRED
  REJECTED
  EXECUTED
}

enum GrowthActionType {
  UPDATE_TITLE
  ADD_INTERNAL_LINKS
  CONTENT_REFRESH
  ADD_CONTENT_SECTION
  FIX_INDEXABILITY
  CREATE_CONTENT
  DIAGNOSE_ONLY
}

enum GrowthActionStatus {
  PLANNED
  REVIEW_REQUIRED
  APPROVED
  EXECUTING
  VERIFYING
  OBSERVING
  SUCCEEDED
  FAILED
  ROLLED_BACK
  CANCELLED
}

enum GrowthRiskLevel {
  A
  B
  C
  D
}

enum GrowthAutonomyDecision {
  AUTO_EXECUTE
  REQUIRE_REVIEW
  REJECT
}

enum GrowthObservationStatus {
  WAITING
  ENOUGH_DATA
  EVALUATED
}

enum GrowthOutcome {
  NOT_READY
  WIN
  NEUTRAL
  LOSS
  INCONCLUSIVE
}

model Profile {
  id                  String               @id @db.Uuid
  email               String               @unique
  displayName         String?              @map("display_name")
  platformRole        PlatformRole         @default(USER) @map("platform_role")
  suspendedAt         DateTime?            @map("suspended_at")
  deletionRequestedAt DateTime?            @map("deletion_requested_at")
  erasureClaimedAt    DateTime?            @map("erasure_claimed_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  memberships         OrganizationMember[]
  reviews             DraftReview[]
  auditEvents         AuditEvent[]         @relation("AuditActor")
  idempotencyKeys     IdempotencyKey[]
  termsAcceptances    TermsAcceptance[]
  notifications       Notification[]

  @@map("profiles")
}

model Organization {
  id                   String                  @id @default(uuid()) @db.Uuid
  name                 String
  creditBalanceMicros  BigInt                  @default(0) @map("credit_balance_micros")
  disabledAt           DateTime?               @map("disabled_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  members              OrganizationMember[]
  sites                Site[]
  integrations         IntegrationConnection[]
  knowledgeSources     KnowledgeSource[]
  dataSnapshots        DataSnapshot[]
  keywordScans         KeywordScan[]
  opportunities        Opportunity[]
  growthPrograms       GrowthProgram[]
  growthRuns           GrowthRun[]
  growthRunStages      GrowthRunStage[]
  jobs                 JobRun[]
  drafts               ContentDraft[]
  publishAttempts      PublishAttempt[]
  payments             PaymentIntent[]
  ledgerEntries        LedgerEntry[]
  creditHolds          CreditHold[]
  usageRecords         UsageRecord[]
  auditEvents          AuditEvent[]
  idempotencyKeys      IdempotencyKey[]
  termsAcceptances     TermsAcceptance[]
  notifications        Notification[]
  indexingObservations IndexingObservation[]
  growthDecisions      GrowthDecision[]
  growthActions        GrowthAction[]
  growthObservations   GrowthObservation[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String           @map("organization_id") @db.Uuid
  profileId      String           @map("profile_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([organizationId, profileId])
  @@index([profileId, organizationId])
  @@map("organization_members")
}

model Site {
  id                            String                  @id @default(uuid()) @db.Uuid
  organizationId                String                  @map("organization_id") @db.Uuid
  domain                        String
  name                          String
  language                      String                  @default("zh-CN")
  wordpressCredentials          Bytes?                  @map("wordpress_credentials")
  wordpressCredentialKeyVersion Int?                    @map("wordpress_credential_key_version")
  wordpressStatus               SiteConnectionStatus    @default(NOT_CONFIGURED) @map("wordpress_status")
  wordpressUser                 String?                 @map("wordpress_user")
  wordpressVerifiedAt           DateTime?               @map("wordpress_verified_at")
  publishPolicy                 PublishPolicy           @default(MANUAL_REVIEW) @map("publish_policy")
  manualPublishSuccesses        Int                     @default(0) @map("manual_publish_successes")
  autoPublishTermsAcceptedAt    DateTime?               @map("auto_publish_terms_accepted_at")
  autoPublishEnabledAt          DateTime?               @map("auto_publish_enabled_at")
  createdAt                     DateTime                @default(now()) @map("created_at")
  updatedAt                     DateTime                @updatedAt @map("updated_at")
  organization                  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrations                  IntegrationConnection[]
  knowledgeSources              KnowledgeSource[]
  dataSnapshots                 DataSnapshot[]
  keywordScans                  KeywordScan[]
  opportunities                 Opportunity[]
  growthPrograms                GrowthProgram[]
  growthRuns                    GrowthRun[]
  growthRunStages               GrowthRunStage[]
  drafts                        ContentDraft[]
  indexingObservations          IndexingObservation[]
  growthDecisions               GrowthDecision[]
  growthActions                 GrowthAction[]
  growthObservations            GrowthObservation[]

  @@unique([organizationId, domain])
  @@index([organizationId, createdAt])
  @@map("sites")
}

model IntegrationConnection {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  siteId               String               @map("site_id") @db.Uuid
  provider             IntegrationProvider
  encryptedCredentials Bytes                @map("encrypted_credentials")
  keyVersion           Int                  @map("key_version")
  propertyId           String?              @map("property_id")
  status               SiteConnectionStatus @default(VERIFYING)
  lastSyncedAt         DateTime?            @map("last_synced_at")
  lastErrorCode        String?              @map("last_error_code")
  lastErrorMessage     String?              @map("last_error_message")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  site                 Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([siteId, provider])
  @@index([organizationId, provider, status])
  @@map("integration_connections")
}

model KnowledgeSource {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  siteId         String?             @map("site_id") @db.Uuid
  type           KnowledgeSourceType
  title          String
  sourceUrl      String?             @map("source_url")
  normalizedUrl  String?             @map("normalized_url")
  content        String
  summary        String?
  checksum       String
  status         DataStatus          @default(LIVE)
  fetchedAt      DateTime?           @map("fetched_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?               @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([organizationId, checksum])
  @@index([organizationId, siteId, status, createdAt])
  @@index([siteId])
  @@map("knowledge_sources")
}

model DataSnapshot {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  siteId               String?        @map("site_id") @db.Uuid
  source               DataSource
  status               DataStatus
  formulaVersion       String?        @map("formula_version")
  providerTaskId       String?        @map("provider_task_id")
  fetchedAt            DateTime       @default(now()) @map("fetched_at")
  availableFrom        DateTime?      @map("available_from")
  periodStart          DateTime?      @map("period_start") @db.Date
  periodEnd            DateTime?      @map("period_end") @db.Date
  comparisonSnapshotId String?        @map("comparison_snapshot_id") @db.Uuid
  payload              Json
  createdAt            DateTime       @default(now()) @map("created_at")
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                 Site?          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keywordScans         KeywordScan[]
  opportunities        Opportunity[]
  drafts               ContentDraft[] @relation("DraftSeoSnapshot")
  comparisonSnapshot   DataSnapshot?  @relation("SnapshotComparison", fields: [comparisonSnapshotId], references: [id], onDelete: SetNull)
  comparisonFor        DataSnapshot[] @relation("SnapshotComparison")

  @@index([organizationId, source, fetchedAt])
  @@index([siteId, source, fetchedAt])
  @@index([siteId, source, periodEnd])
  @@index([comparisonSnapshotId])
  @@index([providerTaskId])
  @@map("data_snapshots")
}

model KeywordScan {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  siteId         String        @map("site_id") @db.Uuid
  snapshotId     String?       @map("snapshot_id") @db.Uuid
  seedKeyword    String        @map("seed_keyword")
  languageCode   String        @map("language_code")
  locationCode   Int           @map("location_code")
  status         JobStatus     @default(QUEUED)
  resultCount    Int           @default(0) @map("result_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  completedAt    DateTime?     @map("completed_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  snapshot       DataSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  opportunities  Opportunity[]

  @@index([organizationId, siteId, createdAt])
  @@index([siteId])
  @@index([snapshotId])
  @@map("keyword_scans")
}

model Opportunity {
  id                       String            @id @default(uuid()) @db.Uuid
  organizationId           String            @map("organization_id") @db.Uuid
  siteId                   String            @map("site_id") @db.Uuid
  keywordScanId            String?           @map("keyword_scan_id") @db.Uuid
  snapshotId               String            @map("snapshot_id") @db.Uuid
  type                     OpportunityType
  status                   OpportunityStatus @default(OPEN)
  sourceKey                String?           @map("source_key")
  title                    String
  targetUrl                String?           @map("target_url")
  keyword                  String?
  searchVolume             Int?              @map("search_volume")
  keywordDifficulty        Int?              @map("keyword_difficulty")
  allintitleCount          Int?              @map("allintitle_count")
  kgrNumerator             BigInt?           @map("kgr_numerator")
  kgrDenominator           BigInt?           @map("kgr_denominator")
  roiScoreMicros           BigInt?           @map("roi_score_micros")
  evidence                 Json              @default("{}")
  trafficPotentialMicros   BigInt?           @map("traffic_potential_micros")
  businessRelevanceMicros  BigInt?           @map("business_relevance_micros")
  successProbabilityMicros BigInt?           @map("success_probability_micros")
  confidenceMicros         BigInt?           @map("confidence_micros")
  executionCostMicros      BigInt?           @map("execution_cost_micros")
  riskPenaltyMicros        BigInt?           @map("risk_penalty_micros")
  expectedValueMicros      BigInt?           @map("expected_value_micros")
  timeToImpactDays         Int?              @map("time_to_impact_days")
  formulaVersion           String            @map("formula_version")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                     Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keywordScan              KeywordScan?      @relation(fields: [keywordScanId], references: [id], onDelete: SetNull)
  snapshot                 DataSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  drafts                   ContentDraft[]
  decisions                GrowthDecision[]
  actions                  GrowthAction[]
  growthRuns               GrowthRun[]

  @@unique([siteId, sourceKey])
  @@index([organizationId, siteId, status, createdAt])
  @@index([siteId, status, expectedValueMicros])
  @@index([keywordScanId])
  @@index([snapshotId])
  @@map("opportunities")
}

model GrowthProgram {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  siteId            String              @map("site_id") @db.Uuid
  mode              GrowthProgramMode
  inputType         GrowthInputType     @map("input_type")
  inputValue        String              @map("input_value")
  inputFingerprint  String              @map("input_fingerprint")
  status            GrowthProgramStatus @default(ACTIVE)
  budgetLimitMicros BigInt?             @map("budget_limit_micros")
  nextRunAt         DateTime?           @map("next_run_at")
  lastRunAt         DateTime?           @map("last_run_at")
  lockedUntil       DateTime?           @map("locked_until")
  consecutiveWins   Int                 @default(0) @map("consecutive_wins")
  deliveredRunCount Int                 @default(0) @map("delivered_run_count")
  lastError         String?             @map("last_error")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site              Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  runs              GrowthRun[]

  @@unique([organizationId, inputFingerprint])
  @@index([status, nextRunAt])
  @@index([organizationId, siteId, createdAt(sort: Desc)])
  @@map("growth_programs")
}

model GrowthRun {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  siteId             String             @map("site_id") @db.Uuid
  programId          String             @map("program_id") @db.Uuid
  jobRunId           String?            @unique @map("job_run_id") @db.Uuid
  opportunityId      String?            @map("opportunity_id") @db.Uuid
  draftId            String?            @map("draft_id") @db.Uuid
  trigger            GrowthRunTrigger
  status             GrowthRunStatus    @default(QUEUED)
  currentStage       GrowthRunStageCode @default(UNDERSTAND) @map("current_stage")
  occurrenceKey      String             @map("occurrence_key")
  resolvedKeyword    String?            @map("resolved_keyword")
  selectedActionType GrowthActionType?  @map("selected_action_type")
  targetUrl          String?            @map("target_url")
  knowledgeSourceIds String[]           @default([]) @map("knowledge_source_ids") @db.Uuid
  delivery           Json?
  observation        Json?
  errorCode          String?            @map("error_code")
  errorMessage       String?            @map("error_message")
  startedAt          DateTime?          @map("started_at")
  deliveredAt        DateTime?          @map("delivered_at")
  finishedAt         DateTime?          @map("finished_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site               Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  program            GrowthProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  jobRun             JobRun?            @relation(fields: [jobRunId], references: [id], onDelete: SetNull)
  opportunity        Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  draft              ContentDraft?      @relation(fields: [draftId], references: [id], onDelete: SetNull)
  stages             GrowthRunStage[]
  decisions          GrowthDecision[]
  actions            GrowthAction[]

  @@unique([programId, occurrenceKey])
  @@index([organizationId, siteId, createdAt(sort: Desc)])
  @@index([programId, status, createdAt(sort: Desc)])
  @@index([siteId, status, updatedAt])
  @@index([opportunityId])
  @@index([draftId])
  @@map("growth_runs")
}

model GrowthRunStage {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  siteId         String               @map("site_id") @db.Uuid
  runId          String               @map("run_id") @db.Uuid
  stage          GrowthRunStageCode
  status         GrowthRunStageStatus @default(PENDING)
  summary        String?
  processedCount Int                  @default(0) @map("processed_count")
  totalCount     Int?                 @map("total_count")
  evidence       Json                 @default("[]")
  errorCode      String?              @map("error_code")
  errorMessage   String?              @map("error_message")
  startedAt      DateTime?            @map("started_at")
  finishedAt     DateTime?            @map("finished_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  run            GrowthRun            @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stage])
  @@index([organizationId, runId, stage])
  @@index([siteId, status, updatedAt])
  @@map("growth_run_stages")
}

model GrowthDecision {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  siteId             String               @map("site_id") @db.Uuid
  runId              String               @map("run_id") @db.Uuid
  opportunityId      String               @map("opportunity_id") @db.Uuid
  status             GrowthDecisionStatus @default(PROPOSED)
  rank               Int
  scoreMicros        BigInt               @map("score_micros")
  scoreVersion       String               @map("score_version")
  rationale          Json
  selectedActionType GrowthActionType?    @map("selected_action_type")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site               Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  run                GrowthRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  opportunity        Opportunity          @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  action             GrowthAction?

  @@unique([runId, opportunityId])
  @@index([organizationId, siteId, status, rank])
  @@index([siteId])
  @@index([opportunityId])
  @@map("growth_decisions")
}

model GrowthAction {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  siteId              String                 @map("site_id") @db.Uuid
  runId               String                 @map("run_id") @db.Uuid
  decisionId          String                 @unique @map("decision_id") @db.Uuid
  opportunityId       String                 @map("opportunity_id") @db.Uuid
  type                GrowthActionType
  status              GrowthActionStatus     @default(PLANNED)
  riskLevel           GrowthRiskLevel        @map("risk_level")
  autonomyDecision    GrowthAutonomyDecision @map("autonomy_decision")
  targetUrl           String?                @map("target_url")
  reversible          Boolean                @default(false)
  plan                Json
  beforeSnapshot      Json?                  @map("before_snapshot")
  afterSnapshot       Json?                  @map("after_snapshot")
  expectedValueMicros BigInt?                @map("expected_value_micros")
  observationStartsAt DateTime?              @map("observation_starts_at")
  observeUntil        DateTime?              @map("observe_until")
  cooldownUntil       DateTime?              @map("cooldown_until")
  executedAt          DateTime?              @map("executed_at")
  verifiedAt          DateTime?              @map("verified_at")
  rolledBackAt        DateTime?              @map("rolled_back_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  run                 GrowthRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  decision            GrowthDecision         @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  opportunity         Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  observations        GrowthObservation[]

  @@index([organizationId, siteId, status, observeUntil])
  @@index([siteId, targetUrl, cooldownUntil])
  @@index([runId])
  @@index([opportunityId])
  @@map("growth_actions")
}

model GrowthObservation {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  siteId              String                  @map("site_id") @db.Uuid
  actionId            String                  @map("action_id") @db.Uuid
  status              GrowthObservationStatus @default(WAITING)
  sourceSnapshotId    String?                 @map("source_snapshot_id") @db.Uuid
  baseline            Json
  measurement         Json?
  controlMeasurement  Json?                   @map("control_measurement")
  estimatedLiftMicros BigInt?                 @map("estimated_lift_micros")
  confidenceMicros    BigInt?                 @map("confidence_micros")
  outcome             GrowthOutcome?
  observedAt          DateTime                @default(now()) @map("observed_at")
  evaluatedAt         DateTime?               @map("evaluated_at")
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  action              GrowthAction            @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([organizationId, siteId, status, observedAt])
  @@index([siteId])
  @@index([actionId, observedAt])
  @@map("growth_observations")
}

model JobRun {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  type           JobType
  status         JobStatus       @default(QUEUED)
  idempotencyKey String?         @map("idempotency_key")
  queueJobId     String?         @unique @map("queue_job_id")
  attempts       Int             @default(0)
  payload        Json
  result         Json?
  errorCode      String?         @map("error_code")
  errorMessage   String?         @map("error_message")
  startedAt      DateTime?       @map("started_at")
  heartbeatAt    DateTime?       @map("heartbeat_at")
  availableAt    DateTime        @default(now()) @map("available_at")
  finishedAt     DateTime?       @map("finished_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditHold     CreditHold?
  publishAttempt PublishAttempt?
  growthRun      GrowthRun?
  usageRecords   UsageRecord[]

  @@unique([organizationId, type, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([status, heartbeatAt])
  @@index([status, availableAt])
  @@map("job_runs")
}

model ContentDraft {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  siteId               String                @map("site_id") @db.Uuid
  opportunityId        String?               @map("opportunity_id") @db.Uuid
  seoSnapshotId        String                @map("seo_snapshot_id") @db.Uuid
  status               DraftStatus           @default(GENERATING)
  title                String
  slug                 String
  html                 String
  qualityReport        Json                  @map("quality_report")
  dataProvenance       Json                  @map("data_provenance")
  knowledgeSourceIds   String[]              @map("knowledge_source_ids") @db.Uuid
  publishedUrl         String?               @map("published_url")
  remotePostId         String?               @map("remote_post_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                 Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  opportunity          Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  seoSnapshot          DataSnapshot          @relation("DraftSeoSnapshot", fields: [seoSnapshotId], references: [id], onDelete: Restrict)
  reviews              DraftReview[]
  publishAttempts      PublishAttempt[]
  indexingObservations IndexingObservation[]
  growthRuns           GrowthRun[]

  @@index([organizationId, siteId, status, createdAt])
  @@index([siteId])
  @@index([opportunityId])
  @@index([seoSnapshotId])
  @@map("content_drafts")
}

model DraftReview {
  id         String         @id @default(uuid()) @db.Uuid
  draftId    String         @map("draft_id") @db.Uuid
  reviewerId String         @map("reviewer_id") @db.Uuid
  decision   ReviewDecision
  comment    String?
  createdAt  DateTime       @default(now()) @map("created_at")
  draft      ContentDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  reviewer   Profile        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([reviewerId])
  @@map("draft_reviews")
}

model PublishAttempt {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  draftId        String               @map("draft_id") @db.Uuid
  jobRunId       String?              @unique @map("job_run_id") @db.Uuid
  status         PublishAttemptStatus @default(QUEUED)
  attemptNumber  Int                  @map("attempt_number")
  remotePostId   String?              @map("remote_post_id")
  remoteUrl      String?              @map("remote_url")
  errorCode      String?              @map("error_code")
  errorMessage   String?              @map("error_message")
  startedAt      DateTime?            @map("started_at")
  finishedAt     DateTime?            @map("finished_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft          ContentDraft         @relation(fields: [draftId], references: [id], onDelete: Cascade)
  jobRun         JobRun?              @relation(fields: [jobRunId], references: [id], onDelete: SetNull)

  @@unique([draftId, attemptNumber])
  @@index([organizationId, status, createdAt])
  @@map("publish_attempts")
}

model IndexingObservation {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  siteId         String        @map("site_id") @db.Uuid
  draftId        String?       @map("draft_id") @db.Uuid
  url            String
  source         String
  indexed        Boolean?
  status         DataStatus
  observedAt     DateTime      @map("observed_at")
  availableFrom  DateTime?     @map("available_from")
  payload        Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  draft          ContentDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, siteId, observedAt])
  @@index([draftId, observedAt])
  @@index([siteId])
  @@map("indexing_observations")
}

model PaymentPackage {
  id               String          @id
  name             String
  baseAmountMicros BigInt          @map("base_amount_micros")
  creditMicros     BigInt          @map("credit_micros")
  active           Boolean         @default(true)
  sortOrder        Int             @default(0) @map("sort_order")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  paymentIntents   PaymentIntent[]

  @@map("payment_packages")
}

model ActionPrice {
  action       String   @id
  name         String
  creditMicros BigInt   @map("credit_micros")
  description  String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("action_prices")
}

model PaymentIntent {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  packageId            String         @map("package_id")
  network              String         @default("TRC20")
  tokenContract        String         @map("token_contract")
  recipientAddress     String         @map("recipient_address")
  baseAmountMicros     BigInt         @map("base_amount_micros")
  expectedAmountMicros BigInt         @map("expected_amount_micros")
  creditMicros         BigInt         @map("credit_micros")
  txHash               String?        @unique @map("tx_hash")
  status               PaymentStatus  @default(AWAITING_TRANSFER)
  verification         Json?
  expiresAt            DateTime       @map("expires_at")
  submittedAt          DateTime?      @map("submitted_at")
  confirmedAt          DateTime?      @map("confirmed_at")
  creditedAt           DateTime?      @map("credited_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package              PaymentPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  ledgerEntries        LedgerEntry[]

  @@index([organizationId, status, createdAt])
  @@index([status, expiresAt])
  @@index([packageId])
  @@map("payment_intents")
}

model LedgerEntry {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  type               LedgerEntryType
  amountMicros       BigInt          @map("amount_micros")
  balanceAfterMicros BigInt          @map("balance_after_micros")
  reason             String
  idempotencyKey     String          @unique @map("idempotency_key")
  paymentIntentId    String?         @map("payment_intent_id") @db.Uuid
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at")
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  paymentIntent      PaymentIntent?  @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([paymentIntentId])
  @@map("ledger_entries")
}

model CreditHold {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  jobRunId       String           @unique @map("job_run_id") @db.Uuid
  amountMicros   BigInt           @map("amount_micros")
  status         CreditHoldStatus @default(HELD)
  reason         String
  createdAt      DateTime         @default(now()) @map("created_at")
  settledAt      DateTime?        @map("settled_at")
  releasedAt     DateTime?        @map("released_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobRun         JobRun           @relation(fields: [jobRunId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("credit_holds")
}

model UsageRecord {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  jobRunId       String?      @map("job_run_id") @db.Uuid
  action         String
  amountMicros   BigInt       @map("amount_micros")
  resultType     String?      @map("result_type")
  resultId       String?      @map("result_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobRun         JobRun?      @relation(fields: [jobRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([jobRunId])
  @@map("usage_records")
}

model IdempotencyKey {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  profileId      String        @map("profile_id") @db.Uuid
  key            String        @db.Uuid
  requestHash    String        @map("request_hash")
  response       Json?
  statusCode     Int?          @map("status_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  expiresAt      DateTime      @map("expires_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, organizationId, key])
  @@index([expiresAt])
  @@index([organizationId])
  @@map("idempotency_keys")
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  action         String
  targetType     String        @map("target_type")
  targetId       String?       @map("target_id")
  traceId        String?       @map("trace_id")
  ipHash         String?       @map("ip_hash")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          Profile?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

model TermsAcceptance {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  profileId      String        @map("profile_id") @db.Uuid
  document       String
  version        String
  acceptedAt     DateTime      @default(now()) @map("accepted_at")
  ipHash         String?       @map("ip_hash")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, organizationId, document, version])
  @@index([organizationId])
  @@map("terms_acceptances")
}

model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  profileId      String?            @map("profile_id") @db.Uuid
  type           String
  title          String
  message        String
  status         NotificationStatus @default(UNREAD)
  metadata       Json?
  createdAt      DateTime           @default(now()) @map("created_at")
  readAt         DateTime?          @map("read_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile?           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([organizationId, profileId, status, createdAt])
  @@index([profileId])
  @@map("notifications")
}

model WorkerHeartbeat {
  workerId       String   @id @map("worker_id")
  queues         String[]
  processVersion String   @map("process_version")
  capabilities   Json     @default("{}")
  heartbeatAt    DateTime @map("heartbeat_at")
  startedAt      DateTime @map("started_at")

  @@index([heartbeatAt])
  @@map("worker_heartbeats")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
