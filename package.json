{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:worker": "tsx server/production/worker.ts",
    "build": "prisma generate && vite build && esbuild server/production/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/production/worker.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/worker.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "supabase:push": "npx --yes supabase@2.81.3 db push",
    "migrate:legacy:dry-run": "tsx scripts/migrate-legacy-json-dry-run.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "6.12.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bullmq": "5.81.1",
    "dompurify": "^3.3.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "5.11.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sanitize-html": "^2.17.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "6.12.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
